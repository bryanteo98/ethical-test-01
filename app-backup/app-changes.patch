+}
+
+/* ── DASHBOARDS ── */
+.app { display: flex; height: 100%; background: var(--dark); color: var(--cream); }
+
+.sidebar {
+  width: 240px; flex: 0 0 240px;
+  height: 100%;
+  background: var(--dark);
+  border-right: 1px solid rgba(243,243,233,0.06);
