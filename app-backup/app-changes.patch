+}
+.action-required .msg { font: 600 14px/1 'Manrope', sans-serif; margin-top: 4px; }
+.action-required .arr { margin-left: auto; }
+
+/* Doc tiles (partner) */
+.doc-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px; }
+.doc {
+  background: var(--cream-2); color: var(--dark);
+  padding: 16px 20px;
+  font: 600 13px/1 'Manrope', sans-serif;
+  cursor: pointer;
+  text-align: center;
+  clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
+  transition: background 0.18s, color 0.18s;
+}
+.doc:hover { background: var(--dark); color: var(--cream); outline: 1px solid var(--orange); }
+
+/* Modal */
+.modal-overlay {
+  position: absolute; inset: 0;
+  background: rgba(0,0,0,0.6);
+  display: grid; place-items: center;
+  z-index: 100;
+  backdrop-filter: blur(2px);
+}
+.modal {
+  background: var(--cream);
+  color: var(--dark);
+  width: 480px;
+  padding: 32px;
+  position: relative;
+  clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px);
