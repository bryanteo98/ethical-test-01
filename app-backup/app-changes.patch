+      <line x1="2.93" y1="2.93" x2="13.07" y2="13.07" stroke="currentColor" strokeWidth={stroke} strokeLinecap="round"/>
+      <line x1="13.07" y1="2.93" x2="2.93" y2="13.07" stroke="currentColor" strokeWidth={stroke} strokeLinecap="round"/>
+    </svg>
+  );
+}
