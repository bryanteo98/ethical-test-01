+.modal h3 {
+  font-family: 'DM Serif Display', serif;
+  font-size: 28px; line-height: 1; font-weight: 400;
+}
+.modal .x {
+  position: absolute; top: 16px; right: 16px;
+  background: transparent; border: 0; cursor: pointer;
+  color: var(--dark); font-size: 20px;
+}
+
+/* Lead detail card */
+.detail-card {
+  border: 1px solid rgba(243,243,233,0.1);
+  margin-top: 16px;
+}
+.detail-card-head {
+  padding: 12px 20px;
+  border-bottom: 1px solid rgba(243,243,233,0.1);
+  font: 700 10px/1 'Manrope', sans-serif;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+  color: rgba(243,243,233,0.6);
+}
+.detail-card-body { padding: 20px; }
+.detail-row {
+  display: grid; grid-template-columns: 100px 1fr;
+  padding: 8px 0;
+  font: 400 13px/1.4 'Manrope', sans-serif;
