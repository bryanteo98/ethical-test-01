+.sb-user .nm { font: 600 13px/1.2 'Manrope', sans-serif; color: var(--cream); }
+.sb-user .role { font: 500 10px/1 'Manrope', sans-serif; color: rgba(243,243,233,0.45); margin-top: 4px; letter-spacing: 0.04em; text-transform: lowercase; }
+.sb-user .tier-badge {
+  margin-left: auto;
+  font: 700 8px/1 'Manrope', sans-serif;
+  color: var(--orange);
+  background: rgba(255,85,0,0.15);
+  padding: 4px 8px;
+  letter-spacing: 0.12em;
+  flex-shrink: 0;
+}
+
+.sb-nav { padding: 16px 0; flex: 1; overflow-y: auto; }
+.sb-item {
