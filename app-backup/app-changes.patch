+.detail-row .k { color: rgba(243,243,233,0.45); }
+.detail-row .v { color: var(--cream); }
+
+.pill {
+  display: inline-flex; align-items: center; gap: 6px;
+  padding: 4px 10px;
+  background: rgba(255,85,0,0.15); color: var(--orange);
