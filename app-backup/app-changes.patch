+}
+.sb-brand { padding: 0 24px 18px; border-bottom: 1px solid rgba(243,243,233,0.06); }
+.sb-brand .logo-word { color: var(--cream); }
+.sb-brand .more-than {
+  margin-top: 4px;
+  font: 700 9px/1 'Manrope', sans-serif;
+  letter-spacing: 0.22em;
+  text-transform: uppercase;
+  color: rgba(243,243,233,0.4);
+  padding-left: 26px;
+}
+
+.sb-user {
+  display: flex; align-items: center; gap: 12px;
+  padding: 18px 24px;
+  border-bottom: 1px solid rgba(243,243,233,0.06);
